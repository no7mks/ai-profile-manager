{
  "enabled": true,
  "name": "Check Write Length (Command)",
  "description": "在调用 fs_write 之前，用 shell 命令检查内容行数。如果超过 200 行则输出警告，提醒 agent 分批写入。",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "fs_write"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "echo '⚠️ 提醒：如果即将写入的内容超过 200 行，请分批写入。先用 fs_write 写入前 200 行，再用 fs_append 每次追加不超过 200 行，直到写完为止。'"
  }
}